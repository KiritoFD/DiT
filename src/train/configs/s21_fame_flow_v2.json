{
  "_comment": "s21 fame 预训练：s20 新架构 (rms/swiglu/qk_norm/RoPE) + fame 名家数据集 (~52k 张, 44 位规范书家, 全白底黑字)。eval_fame_strict (组合泛化口径), eval cfg=0.7 (ctrl 侧已验证 0.7 优于 1.7; 基模同口径对齐)。",
  "experiment_name": "s21-fame-flow-v2",
  "data_csv": "5script/train_fame.csv",
  "latent_shards_dir": "final_latents_fame",
  "img_root": "final_imgs_256",
  "results_dir": "5script/results/s21_fame_flow_v2",

  "model": "DiT-2Cond-S/2",
  "cond_mode": "2cond",
  "condition_fusion": "factorized_add",
  "callig_embed_dim": 128,
  "char_embed_dim": 384,
  "char_dino_embeddings": "pretrained_models/dino_embeddings/glyph_dino_embeddings_384.npy",
  "char_dino_index": "pretrained_models/dino_embeddings/glyph_dino_index.json",
  "char_proj_mode": "mlp",
  "freeze_char_table": true,
  "dino_per_script_center": 1,
  "dino_fill_unknown": 1,
  "cond_drop_all_prob": 0.05,
  "cond_drop_one_prob": 0.25,
  "cond_drop_which_glyph_prob": 0.75,

  "image_size": 256,
  "num_calligraphers": 1013,
  "num_characters": 35130,
  "use_checkpoint": false,

  "epochs": 100000,
  "max_steps": 150000,
  "lr": 1.5e-4,
  "lr_schedule": "cosine",
  "warmup_steps": 3000,
  "min_lr_ratio": 0.1,
  "weight_decay": 0.02,
  "global_batch_size": 192,
  "global_seed": 0,
  "sampler": "factor_balanced",
  "balance_char_alpha": 0.35,
  "balance_callig_alpha": 0.15,

  "use_ema": true,
  "ema_decay": 0.9999,
  "ema_warmup": true,
  "vae_path": "pretrained_models/sd-vae-ft-ema",
  "use_lora": false,
  "reset_cond_head": false,
  "train_cond_head": false,
  "w_glyph_cond": false,
  "use_canny": false,
  "use_skel": false,
  "w_canny": 0.0,
  "w_skel": 0.0,
  "w_skel_head": 0.0,
  "w_repa": 0.0,

  "preload": true,
  "preload_workers": 48,
  "num_workers": 8,
  "log_every": 20,
  "ckpt_every": 2500,
  "ckpt_keep": 0,

  "auto_eval": true,
  "eval_csv": "5script/eval_fame_strict.csv",
  "eval_n": 500,
  "eval_steps": 25,
  "eval_cfg": 0.7,
  "eval_seed": 0,
  "eval_batch": 50,
  "eval_vae_batch": 16,
  "show5_csv": "",

  "early_stop": true,
  "early_stop_metric": "ssim_lpips",
  "early_stop_patience": 5,
  "early_stop_min_delta": 0.002,
  "early_stop_min_delta_lpips": 0.003,
  "early_stop_min_steps": 20000,

  "diffusion_type": "flow",
  "t_sampler": "logit_normal",
  "t_mean": 0.0,
  "t_std": 1.0,
  "flow_sampler": "heun",
  "heun_batch": 1,
  "shift": 1.0,

  "norm_type": "rms",
  "mlp_type": "swiglu",
  "qk_norm": 1,
  "rope": 1,
  "rope_theta": 100.0,
  "attn_impl": "sdpa"
}
