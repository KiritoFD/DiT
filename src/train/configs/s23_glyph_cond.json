{
  "_comment": "s23 glyph-cond 模式：在 s21 基线上启用 w_glyph_cond（标准字形 latent 作为空间条件）。这是独立可开关的模式，与 s21 的唯一差异就是 w_glyph_cond=false->true，其余超参严格一致，保证唯一变量。科学意义：骨架条件(ControlNet)能带来 +0.29 SSIM 但**必须从目标图抽取**，推理时拿不到；标准字形 latent 同样是 4x32x32 空间图，但**只需知道写哪个字**，推理时天然可得——若它也能带来大幅提升，就把 ControlNet 的 0.80 从『复刻』变成『零样本生成』。覆盖：fame 上 v2 字典命中 53.1%（行/楷/隶 62-66%，六体 100% 但属借用字形，草/篆 0% 无标准字体）。草篆样本会给零张量，模型需自行学会忽略。",
  "_bugfix_note": "本模式依赖两处修复：(1) latent_dataset.py/dataset.py 的标准字形查询从失效的 v1(get_glyph_lookup, std_glyph_latent 目录不存在, fame 命中率 0.0%) 改为 v2(get_glyph_lookup_v2, std_glyph_latent_v2, 53.1%)；(2) train.py 调 prepare_eval_cache 时传入 use_glyph_cond，使 eval 侧同步喂 g——否则训练喂 g 而 eval 不喂，条件域不匹配会让指标失真为『该条件无效』。",

  "experiment_name": "s23-glyph-cond",
  "data_csv": "5script/train_fame.csv",
  "latent_shards_dir": "final_latents_fame",
  "img_root": "final_imgs_256",
  "results_dir": "5script/results/s23_glyph_cond",

  "model": "DiT-2Cond-S/2",
  "cond_mode": "2cond",
  "condition_fusion": "factorized_add",
  "callig_embed_dim": 128,
  "char_embed_dim": 384,
  "char_dino_embeddings": "pretrained_models/dino_embeddings/glyph_dino_embeddings_384.npy",
  "char_dino_index": "pretrained_models/dino_embeddings/glyph_dino_index.json",
  "char_proj_mode": "mlp",
  "freeze_char_table": true,
  "dino_per_script_center": 1,
  "dino_fill_unknown": 1,
  "cond_drop_all_prob": 0.05,
  "cond_drop_one_prob": 0.25,
  "cond_drop_which_glyph_prob": 0.75,

  "_glyph_mode": "=== 本模式的核心开关：以下两项同时为 true 才构成完整的 glyph-cond 模式 ===",
  "w_glyph_cond": true,
  "glyph_scale_init": 0.4,

  "image_size": 256,
  "num_calligraphers": 1013,
  "num_characters": 35130,
  "latent_channels": 4,
  "use_checkpoint": false,

  "epochs": 100000,
  "max_steps": 150000,
  "lr": 1.5e-4,
  "lr_schedule": "cosine",
  "warmup_steps": 3000,
  "min_lr_ratio": 0.1,
  "weight_decay": 0.02,
  "global_batch_size": 192,
  "global_seed": 0,
  "sampler": "factor_balanced",
  "balance_char_alpha": 0.35,
  "balance_callig_alpha": 0.15,

  "use_ema": true,
  "ema_decay": 0.9999,
  "ema_warmup": true,
  "vae_path": "pretrained_models/sd-vae-ft-ema",
  "vae_scaling_factor": 0.18215,
  "use_lora": false,
  "reset_cond_head": false,
  "train_cond_head": false,

  "preload": true,
  "preload_workers": 48,
  "num_workers": 8,
  "log_every": 20,
  "ckpt_every": 2500,
  "ckpt_keep": 0,

  "auto_eval": true,
  "eval_csv": "5script/eval_fame_strict.csv",
  "eval_n": 500,
  "eval_steps": 25,
  "eval_cfg": 0.7,
  "eval_seed": 0,
  "eval_batch": 50,
  "eval_vae_batch": 16,
  "show5_csv": "",

  "early_stop": true,
  "early_stop_metric": "ssim_lpips",
  "early_stop_patience": 5,
  "early_stop_min_delta": 0.002,
  "early_stop_min_delta_lpips": 0.003,
  "early_stop_min_steps": 20000,

  "diffusion_type": "flow",
  "t_sampler": "logit_normal",
  "t_mean": 0.0,
  "t_std": 1.0,
  "flow_sampler": "heun",
  "heun_batch": 1,
  "shift": 1.0,

  "norm_type": "rms",
  "mlp_type": "swiglu",
  "qk_norm": 1,
  "rope": 1,
  "rope_theta": 100.0,
  "attn_impl": "sdpa",

  "w_canny": 0.0,
  "w_skel": 0.0,
  "w_skel_head": 0.0,
  "w_repa": 0.0,
  "use_canny": false,
  "use_skel": false
}
