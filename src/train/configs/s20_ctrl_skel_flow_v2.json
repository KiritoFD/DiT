{
  "_comment": "ControlNet 后训练管线（v2）。必须在 s20 预训练主模型之上训练。",
  "_changes": {
    "arch_consistency": "norm_type/mlp_type/qk_norm/rope/attn_impl 必须与 --main-ckpt 的训练配置完全一致，否则两侧特征分布不匹配",
    "routing": "main block 现在接收 rope；旧代码 block(x,c) 会让主模型静默丢失位置信息",
    "injection": "modulate: x*(1+s)+t，zero-init 仍保证恒等 warm-start，但可增强也可抑制残差流",
    "null_cond": "gaussian 替代 zeros —— 零 latent 解码是特定灰块而非空白，与真实骨骼分布差距大",
    "main_ckpt": "路径失效时硬失败（旧代码静默用随机主模型训练）",
    "ema": "改用 named_parameters 名字匹配，不再 zip 位置匹配；warmup base 用 --ema-decay 而非硬编码 0.9999",
    "flow": "与主模型同 t_sampler/logit_normal + heun，训练侧与推理侧共用同一份"
  },

  "experiment_name": "s20-ctrl-skel-flow-v2",
  "results_dir": "5script/results/s20_ctrl_skel_flow_v2",

  "model": "DiT-2Cond-S/2",
  "main_ckpt": "PLACEHOLDER_s20_best_ema_pt",
  "train_ctrl_only": true,
  "csv": "5script/train_mid_clean.csv",
  "latent_shards_dir": "final_latents_mid_clean",
  "skel_root": "final_skeleton_d3",
  "skel_latent_shards_dir": "",
  "skel_cond_channels": 4,

  "num_calligraphers": 1011,
  "num_characters": 35130,
  "condition_fusion": "factorized_add",
  "callig_embed_dim": 128,
  "char_embed_dim": 384,
  "char_dino_embeddings": "pretrained_models/dino_embeddings/glyph_dino_embeddings_384.npy",
  "char_dino_index": "pretrained_models/dino_embeddings/glyph_dino_index.json",
  "char_proj_mode": "ln_only",
  "freeze_char_table": true,
  "cond_drop_all_prob": 0.05,
  "cond_drop_one_prob": 0.25,
  "cond_drop_struct_prob": 0.1,

  "diffusion_type": "flow",
  "t_sampler": "logit_normal",
  "t_mean": 0.0,
  "t_std": 1.0,
  "flow_sampler": "heun",
  "heun_batch": 1,
  "shift": 1.0,

  "norm_type": "rms",
  "mlp_type": "swiglu",
  "qk_norm": 1,
  "rope": 1,
  "rope_theta": 100.0,
  "attn_impl": "sdpa",

  "ctrl_depth": 0,
  "ctrl_hidden": 0,
  "ctrl_num_heads": 0,
  "injection": "modulate",
  "null_cond": "gaussian",

  "epochs": 1400,
  "max_steps": 100000,
  "lr": 3e-4,
  "warmup_steps": 500,
  "min_lr_ratio": 0.1,
  "weight_decay": 0.01,
  "batch_size": 96,
  "num_workers": 4,
  "log_every": 50,
  "ckpt_every": 5000,
  "ckpt_keep": 3,
  "use_ema": true,
  "ema_decay": 0.9999,
  "preload": true,
  "preload_workers": 16,
  "use_checkpoint": false,
  "seed": 0,
  "resume": "",

  "gpu_eval_csv": "",
  "gpu_eval_every": 2500,
  "gpu_eval_n": 100,
  "gpu_eval_steps": 25,
  "gpu_eval_cfg": 1.7,
  "gpu_eval_img_root": "final_imgs_256",
  "gpu_eval_skel_root": "final_skeleton_d3",
  "gpu_eval_skel_latent_shards_dir": "",
  "gpu_eval_dit_batch": 16,
  "gpu_eval_vae_batch": 16
}
