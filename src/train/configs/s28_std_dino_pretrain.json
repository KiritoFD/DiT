{
  "_comment": "s28 标准字形 DINO 字嵌入预训练（清洗数据版）：char/glyph embedding 用「标准字形(kai/li) DINO 特征」PCA 降维到 384 冻结查表 + 直通（ln_only）。核心：(1) 标准字形 DINO 外形一致性 AUC 0.906；(2) 冻结查表零可训练参数，不用可训练投影扭曲信号；(3) char_proj_mode=ln_only 直通进 adaLN；(4) use_ot=true (OT-CFM 最优传输重排)；(5) 数据用清洗版：train_fame_clean.csv + final_latents_fame_clean（1430 张修复图局部替换 latent），eval 用 eval_fame_strict_clean.csv（27 张修复图 GT 实时读图）。",
  "experiment_name": "s28-std-dino-pretrain",
  "data_csv": "5script/train_fame_clean.csv",
  "latent_shards_dir": "final_latents_fame_clean",
  "img_root": "final_imgs_256",
  "results_dir": "5script/results/s28_std_dino_pretrain",

  "model": "DiT-2Cond-S/2",
  "cond_mode": "2cond",
  "condition_fusion": "factorized_add",
  "callig_embed_dim": 128,
  "char_embed_dim": 384,
  "char_proj_mode": "ln_only",

  "use_std_dino_char_embedder": true,
  "std_dino_table_path": "_sync_work/std_dino_char_table_384_pca.npy",

  "cond_drop_all_prob": 0.10,
  "cond_drop_one_prob": 0.25,
  "cond_drop_which_glyph_prob": 0.80,

  "w_glyph_cond": false,
  "glyph_scale_init": 0.4,

  "image_size": 256,
  "num_calligraphers": 1013,
  "num_characters": 35130,
  "latent_channels": 4,
  "use_checkpoint": false,

  "epochs": 100000,
  "max_steps": 150000,
  "lr": 1.5e-4,
  "lr_schedule": "cosine",
  "warmup_steps": 3000,
  "min_lr_ratio": 0.1,
  "weight_decay": 0.02,
  "global_batch_size": 192,
  "global_seed": 0,
  "sampler": "factor_balanced",
  "balance_char_alpha": 0.35,
  "balance_callig_alpha": 0.15,

  "use_ema": true,
  "ema_decay": 0.9999,
  "ema_warmup": true,
  "vae_path": "pretrained_models/sd-vae-ft-ema",
  "vae_scaling_factor": 0.18215,
  "use_lora": false,
  "reset_cond_head": false,
  "train_cond_head": false,

  "preload": true,
  "preload_workers": 48,
  "num_workers": 8,
  "log_every": 20,
  "ckpt_every": 2500,
  "ckpt_keep": 0,

  "auto_eval": true,
  "eval_csv": "5script/eval_fame_strict_clean.csv",
  "eval_n": 500,
  "eval_steps": 25,
  "eval_cfg": 0.7,
  "eval_seed": 0,
  "eval_batch": 50,
  "eval_vae_batch": 16,
  "show5_csv": "",

  "early_stop": true,
  "early_stop_metric": "ssim_lpips",
  "early_stop_patience": 5,
  "early_stop_min_delta": 0.002,
  "early_stop_min_delta_lpips": 0.003,
  "early_stop_min_steps": 20000,

  "diffusion_type": "flow",
  "t_sampler": "logit_normal",
  "t_mean": 0.0,
  "t_std": 1.0,
  "flow_sampler": "heun",
  "heun_batch": 1,
  "shift": 1.0,
  "use_ot": true,

  "norm_type": "rms",
  "mlp_type": "swiglu",
  "qk_norm": 1,
  "rope": 1,
  "rope_theta": 100.0,
  "attn_impl": "sdpa",

  "w_canny": 0.0,
  "w_skel": 0.0,
  "w_skel_head": 0.0,
  "w_repa": 0.0,
  "use_canny": false,
  "use_skel": false
}
