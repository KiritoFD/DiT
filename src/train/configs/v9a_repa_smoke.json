{
  "_comment": "v9a-smoke: v9a REPA 预训练短冒烟 (300 步, batch64), 验证 REPA loss 真正加载 (train.py flow 禁用 w_repa 已修复)。仅 max_steps/batch/exp 与全量不同, 其余 v9a 配方。验证通过后跑 v9a_repa_pretrain.json 全量。",
  "experiment_name": "v9a-repa-smoke",

  "results_dir": "5script/results/v9a_repa_pretrain_smoke",

  "data_csv": "5script/train_fame_clean_v8.csv",
  "latent_shards_dir": "final_latents_fame_v8",
  "img_root": "final_imgs_fame_v8",

  "model": "DiT-2Cond-S/2",
  "cond_mode": "2cond",
  "condition_fusion": "factorized_add",
  "callig_embed_dim": 128,
  "char_embed_dim": 384,
  "char_proj_mode": "mlp",
  "freeze_char_table": true,
  "char_dino_embeddings": "pretrained_models/dino_embeddings/glyph_dino_embeddings_384.npy",
  "char_dino_index": "pretrained_models/dino_embeddings/glyph_dino_index.json",
  "dino_per_script_center": 1,
  "dino_fill_unknown": 1,

  "cond_drop_all_prob": 0.05,
  "cond_drop_one_prob": 0.30,
  "cond_drop_which_glyph_prob": 0.85,
  "w_glyph_cond": false,
  "glyph_scale_init": 0.4,

  "image_size": 256,
  "num_calligraphers": 1013,
  "num_characters": 35130,
  "latent_channels": 4,
  "use_checkpoint": false,
  "compile": true,
  "compile_mode": "default",

  "epochs": 1000,
  "max_steps": 300,
  "lr": 1.5e-4,
  "lr_schedule": "cosine",
  "warmup_steps": 50,
  "min_lr_ratio": 0.1,
  "weight_decay": 0.02,
  "global_batch_size": 64,
  "global_seed": 0,
  "sampler": "factor_balanced",
  "balance_char_alpha": 0.35,
  "balance_callig_alpha": 0.15,

  "use_ema": true,
  "ema_decay": 0.9999,
  "ema_warmup": true,
  "vae_path": "pretrained_models/sd-vae-ft-ema",
  "vae_scaling_factor": 0.18215,
  "use_lora": false,
  "reset_cond_head": false,
  "train_cond_head": false,

  "preload": true,
  "preload_workers": 48,
  "num_workers": 8,
  "log_every": 20,
  "ckpt_every": 300,
  "ckpt_keep": 0,

  "auto_eval": false,
  "eval_csv": "",
  "eval_n": 100,
  "eval_steps": 25,
  "eval_cfg": 0.7,
  "eval_seed": 0,
  "eval_batch": 50,
  "eval_vae_batch": 16,
  "show5_csv": "",

  "early_stop": false,

  "diffusion_type": "flow",
  "t_sampler": "logit_normal",
  "t_mean": 0.0,
  "t_std": 1.0,
  "flow_sampler": "heun",
  "heun_batch": 1,
  "shift": 1.0,

  "w_repa": 0.1,
  "repa_teacher_ckpt": "pretrained_models/dinov2_vits14_pretrain.safetensors",
  "use_canny": false,
  "use_skel": false
}