{
  "_comment": "muon-smoke: 最小规模冒烟验证 Muon 能否收敛无 NaN。batch 缩到 64, max_steps 2000 (~10min)。对照 adamw 用同 config 但 --optimizer adamw。看 loss 是否稳定下降。",
  "experiment_name": "muon-smoke",
  "data_csv": "5script/train_fame_clean_v8.csv",
  "latent_shards_dir": "final_latents_fame_v8",
  "img_root": "final_imgs_fame_v8",
  "results_dir": "5script/results/optim_smoke",

  "model": "DiT-2Cond-S/2",
  "cond_mode": "2cond",
  "condition_fusion": "factorized_add",
  "callig_embed_dim": 128,
  "char_embed_dim": 384,
  "char_proj_mode": "mlp",
  "freeze_char_table": true,
  "char_dino_embeddings": "pretrained_models/dino_embeddings/glyph_dino_embeddings_384.npy",
  "char_dino_index": "pretrained_models/dino_embeddings/glyph_dino_index.json",
  "dino_per_script_center": 1,
  "dino_fill_unknown": 1,

  "cond_drop_all_prob": 0.05,
  "cond_drop_one_prob": 0.30,
  "cond_drop_which_glyph_prob": 0.85,
  "w_glyph_cond": false,
  "glyph_scale_init": 0.4,

  "image_size": 256,
  "num_calligraphers": 1013,
  "num_characters": 35130,
  "latent_channels": 4,
  "use_lora": false,

  "diffusion_type": "flow",
  "t_sampler": "logit_normal",
  "t_mean": 0.0,
  "t_std": 1.0,
  "flow_sampler": "heun",
  "heun_batch": 1,
  "shift": 1.0,

  "norm_type": "rms",
  "mlp_type": "swiglu",
  "qk_norm": 1,
  "rope": 1,
  "rope_theta": 100.0,
  "attn_impl": "sdpa",

  "epochs": 100,
  "max_steps": 2000,
  "optimizer": "muon",
  "muon_lr": 0.02,
  "lr": 3e-4,
  "warmup_steps": 100,
  "min_lr_ratio": 0.1,
  "weight_decay": 0.01,
  "batch_size": 64,
  "num_workers": 4,
  "log_every": 50,
  "ckpt_every": 2000,
  "ckpt_keep": 0,

  "compile": true,
  "compile_mode": "default",
  "use_ema": true,
  "ema_decay": 0.9999,
  "use_ot": true,
  "ot_chunks": 4,
  "preload": true,
  "preload_workers": 16,
  "use_checkpoint": false,
  "seed": 0,

  "early_stop": false,
  "gpu_eval_csv": ""
}