{
  "_comment": "s25 IDS 组件码本预训练：用 IDS 部件嵌入替代 DINO 字表。核心改动：(1) use_ids_char_embedder=true，字嵌入 = 部件嵌入池化（1571 部件 vs 35130 字，参数降 95.5%）；(2) 零样本泛化：没见过的字查 IDS 组合即得嵌入；(3) 书体解耦：部件是书体无关的，书体差异全归 callig 分支；(4) 草篆覆盖：部件从真迹学，不依赖标准字体。IDS 覆盖率 4763/4765=100%，扁平池化歧义率仅 1.02%（多为异体字）。",
  "experiment_name": "s25-ids-pretrain",
  "data_csv": "5script/train_fame.csv",
  "latent_shards_dir": "final_latents_fame",
  "img_root": "final_imgs_256",
  "results_dir": "5script/results/s25_ids_pretrain",

  "model": "DiT-2Cond-S/2",
  "cond_mode": "2cond",
  "condition_fusion": "factorized_add",
  "callig_embed_dim": 128,
  "char_embed_dim": 384,

  "use_ids_char_embedder": true,
  "ids_file": "_sync_work/cjkvi-ids/cjkvi-ids-master/ids.txt",
  "ids_char_map_csv": "5script/train_fame.csv",

  "cond_drop_all_prob": 0.10,
  "cond_drop_one_prob": 0.25,
  "cond_drop_which_glyph_prob": 0.80,

  "w_glyph_cond": false,
  "glyph_scale_init": 0.4,

  "image_size": 256,
  "num_calligraphers": 1013,
  "num_characters": 35130,
  "latent_channels": 4,
  "use_checkpoint": false,

  "epochs": 100000,
  "max_steps": 150000,
  "lr": 1.5e-4,
  "lr_schedule": "cosine",
  "warmup_steps": 3000,
  "min_lr_ratio": 0.1,
  "weight_decay": 0.02,
  "global_batch_size": 192,
  "global_seed": 0,
  "sampler": "factor_balanced",
  "balance_char_alpha": 0.35,
  "balance_callig_alpha": 0.15,

  "use_ema": true,
  "ema_decay": 0.9999,
  "ema_warmup": true,
  "vae_path": "pretrained_models/sd-vae-ft-ema",
  "vae_scaling_factor": 0.18215,
  "use_lora": false,
  "reset_cond_head": false,
  "train_cond_head": false,

  "preload": true,
  "preload_workers": 48,
  "num_workers": 8,
  "log_every": 20,
  "ckpt_every": 2500,
  "ckpt_keep": 0,

  "auto_eval": true,
  "eval_csv": "5script/eval_fame_strict.csv",
  "eval_n": 500,
  "eval_steps": 25,
  "eval_cfg": 0.7,
  "eval_seed": 0,
  "eval_batch": 50,
  "eval_vae_batch": 16,
  "show5_csv": "",

  "early_stop": true,
  "early_stop_metric": "ssim_lpips",
  "early_stop_patience": 5,
  "early_stop_min_delta": 0.002,
  "early_stop_min_delta_lpips": 0.003,
  "early_stop_min_steps": 20000,

  "diffusion_type": "flow",
  "t_sampler": "logit_normal",
  "t_mean": 0.0,
  "t_std": 1.0,
  "flow_sampler": "heun",
  "heun_batch": 1,
  "shift": 1.0,

  "norm_type": "rms",
  "mlp_type": "swiglu",
  "qk_norm": 1,
  "rope": 1,
  "rope_theta": 100.0,
  "attn_impl": "sdpa",

  "w_canny": 0.0,
  "w_skel": 0.0,
  "w_skel_head": 0.0,
  "w_repa": 0.0,
  "use_canny": false,
  "use_skel": false
}
