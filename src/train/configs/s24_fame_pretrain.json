{
  "_comment": "s24 fame 基本预训练：只用 fame 真迹 + glyph级DINO字嵌入，不喂标准字形空间条件（那是后训练内容）。设计依据：(1) 字级DINO表(768d)实测不可用——字间余弦均值0.83窄锥，中心化后最近邻多为无关字（跨书体平均抹掉了字身份），故仍用glyph级384d表（异字余弦0.08，覆盖fame glyph 91.8%）。(2) 字信号被掩盖的主因是幅度（callig_proj 12.90 vs char_proj 7.32）与冻结容量不足，而非drop频率——故解冻字表（DINO初始化作先验，训练中向任务几何漂移）+ drop偏向保字（字在场85%/书家在场70%）+ 可学习char_scale。(3) fame 44书家40个写多书体，书体信号必须由字分支提供，glyph=script×char 的书体分量是必需信息而非纯噪声。与 s23 的唯一变量：w_glyph_cond off + freeze_char_table off + drop 配比。",
  "experiment_name": "s24-fame-pretrain",
  "data_csv": "5script/train_fame.csv",
  "latent_shards_dir": "final_latents_fame",
  "img_root": "final_imgs_256",
  "results_dir": "5script/results/s24_fame_pretrain",

  "model": "DiT-2Cond-S/2",
  "cond_mode": "2cond",
  "condition_fusion": "factorized_add",
  "callig_embed_dim": 128,
  "char_embed_dim": 384,
  "char_dino_embeddings": "pretrained_models/dino_embeddings/glyph_dino_embeddings_384.npy",
  "char_dino_index": "pretrained_models/dino_embeddings/glyph_dino_index.json",
  "char_proj_mode": "mlp",
  "freeze_char_table": false,
  "dino_per_script_center": 1,
  "dino_fill_unknown": 1,
  "cond_drop_all_prob": 0.10,
  "cond_drop_one_prob": 0.25,
  "cond_drop_which_glyph_prob": 0.80,

  "w_glyph_cond": false,
  "glyph_scale_init": 0.4,

  "image_size": 256,
  "num_calligraphers": 1013,
  "num_characters": 35130,
  "latent_channels": 4,
  "use_checkpoint": false,

  "epochs": 100000,
  "max_steps": 150000,
  "lr": 1.5e-4,
  "lr_schedule": "cosine",
  "warmup_steps": 3000,
  "min_lr_ratio": 0.1,
  "weight_decay": 0.02,
  "global_batch_size": 192,
  "global_seed": 0,
  "sampler": "factor_balanced",
  "balance_char_alpha": 0.35,
  "balance_callig_alpha": 0.15,

  "use_ema": true,
  "ema_decay": 0.9999,
  "ema_warmup": true,
  "vae_path": "pretrained_models/sd-vae-ft-ema",
  "vae_scaling_factor": 0.18215,
  "use_lora": false,
  "reset_cond_head": false,
  "train_cond_head": false,

  "preload": true,
  "preload_workers": 48,
  "num_workers": 8,
  "log_every": 20,
  "ckpt_every": 2500,
  "ckpt_keep": 0,

  "auto_eval": true,
  "eval_csv": "5script/eval_fame_strict.csv",
  "eval_n": 500,
  "eval_steps": 25,
  "eval_cfg": 0.7,
  "eval_seed": 0,
  "eval_batch": 50,
  "eval_vae_batch": 16,
  "show5_csv": "",

  "early_stop": true,
  "early_stop_metric": "ssim_lpips",
  "early_stop_patience": 5,
  "early_stop_min_delta": 0.002,
  "early_stop_min_delta_lpips": 0.003,
  "early_stop_min_steps": 20000,

  "diffusion_type": "flow",
  "t_sampler": "logit_normal",
  "t_mean": 0.0,
  "t_std": 1.0,
  "flow_sampler": "heun",
  "heun_batch": 1,
  "shift": 1.0,

  "norm_type": "rms",
  "mlp_type": "swiglu",
  "qk_norm": 1,
  "rope": 1,
  "rope_theta": 100.0,
  "attn_impl": "sdpa",

  "w_canny": 0.0,
  "w_skel": 0.0,
  "w_skel_head": 0.0,
  "w_repa": 0.0,
  "use_canny": false,
